{
  "name": "ajentify-voice-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for @ajentify/voice and its examples",
  "scripts": {
    "build": "pnpm -r --filter @ajentify/voice build",
    "dev": "pnpm -r --parallel --filter @ajentify/voice dev",
    "dev:vite": "pnpm --filter ajentify-voice-example-vite dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18"
  }
}
